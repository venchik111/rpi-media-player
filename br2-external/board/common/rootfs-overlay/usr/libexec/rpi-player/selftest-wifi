#!/bin/sh
# Diagnostics (used by the QEMU tests with mac80211_hwsim): join our own access point from the 2nd simulated radio (in a
# separate network namespace), get a DHCP lease and fetch the HLS playlist.
# Exit code 0 = Wi-Fi path works end to end.
set -u
. /run/rpi-player.env
NS=wifi-client
PHY=phy1

cleanup() {
	[ -f /run/selftest-wpa.pid ] && ip netns exec $NS kill "$(cat /run/selftest-wpa.pid)" 2>/dev/null
	ip netns exec $NS iw phy "$PHY" set netns 1 2>/dev/null
	ip netns del $NS 2>/dev/null
}
trap cleanup EXIT

ip netns add $NS || exit 1
iw phy "$PHY" set netns name $NS || exit 1
CIF=$(ip netns exec $NS ls /sys/class/net | grep -v '^lo$' | head -n1)
ip netns exec $NS ip link set lo up
ip netns exec $NS ip link set "$CIF" up

if [ -n "$AP_PASSPHRASE" ]; then
	wpa_passphrase "$AP_SSID" "$AP_PASSPHRASE" > /run/selftest-wpa.conf
else
	printf 'network={\n ssid="%s"\n key_mgmt=NONE\n}\n' "$AP_SSID" > /run/selftest-wpa.conf
fi
ip netns exec $NS wpa_supplicant -B -D nl80211 -i "$CIF" -c /run/selftest-wpa.conf \
	-P /run/selftest-wpa.pid >/dev/null || exit 2

ip netns exec $NS udhcpc -q -n -t 10 -i "$CIF" -s /usr/share/udhcpc/default.script >/dev/null 2>&1 \
	|| { echo "FAIL: no DHCP lease"; exit 3; }
echo "client address: $(ip netns exec $NS ip -4 -o addr show "$CIF" | awk '{print $4}')"

ip netns exec $NS wget -q -O - "http://$AP_ADDR:${HLS_PORT:-8080}/stream.m3u8" > /run/selftest.m3u8 \
	|| { echo "FAIL: playlist not reachable over Wi-Fi"; exit 4; }
grep -q '#EXTM3U' /run/selftest.m3u8 || { echo "FAIL: not a playlist"; exit 5; }
echo "OK: HLS playlist received over Wi-Fi"
