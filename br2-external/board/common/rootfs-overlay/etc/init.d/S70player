#!/bin/sh
# HLS "webcam": supervisor (player-ctl) + upload watcher (inotifyd).
PID=/run/player-ctl.pid
WPID=/run/player-watch.pid

case "$1" in
	start)
		start-stop-daemon -S -q -b -m -p "$PID" -x /usr/sbin/player-ctl -- run
		start-stop-daemon -S -q -b -m -p "$WPID" -x /bin/busybox -- inotifyd \
			/usr/libexec/rpi-player/on-upload /data/media:wyd
		;;
	stop)
		start-stop-daemon -K -q -p "$WPID"
		start-stop-daemon -K -q -p "$PID"
		rm -f "$PID" "$WPID"
		;;
	restart) "$0" stop; sleep 1; "$0" start ;;
	reload) [ -f "$PID" ] && kill -HUP "$(cat "$PID")" ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
